<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #181818;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.movieapp.FilmDetailsController">
    <children>
        <!-- Header Section -->
        <StackPane layoutX="0.0" layoutY="0.0" prefHeight="80.0" prefWidth="800.0" style="-fx-background-color: linear-gradient(to right, #c44018, #8e1c0c);">
            <Label text="Movie Zone" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="36.0" />
                </font>
            </Label>
        </StackPane>

        <!-- Poster Section -->
        <ImageView fx:id="posterImage" fitHeight="300.0" fitWidth="200.0" layoutX="40.0" layoutY="120.0" style="-fx-effect: dropshadow(gaussian, black, 10, 0.5, 0, 0);" />

        <!-- Details Section -->
        <VBox layoutX="280.0" layoutY="120.0" prefWidth="460.0" spacing="15.0">
            <!-- Title -->
            <Label fx:id="titleLabel" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Movie Title" wrapText="true" />

            <!-- Description -->
            <TextArea fx:id="descriptionText" prefHeight="200.0" prefWidth="400.0" style="-fx-background-color: #222; -fx-border-color: #c44018; -fx-border-radius: 5; -fx-text-fill: white;" wrapText="true">
                <font>
                    <Font name="System Regular" size="16.0" />
                </font>
            </TextArea>
        </VBox>

        <!-- Back Button -->
        <Button fx:id="backBtn" layoutX="40.0" layoutY="480.0" onAction="#handleBack" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #c44018; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;" text="Back" textFill="WHITE">
<!--            <hover>-->
<!--                <style>-->
<!--                    -fx-background-color: #a83214;-->
<!--                </style>-->
<!--            </hover>-->
        </Button>
    </children>
</AnchorPane>
