<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="502.0" prefWidth="1250.0" style="-fx-background-color: #000;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.movieapp.AllFilms">
   <children>
      <!-- Title -->
      <Label layoutX="525.0" layoutY="20.0" text="Movie Zone!" textFill="WHITE" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, #c44018, 5, 0.5, 0, 1);" />

      <!-- Back Button -->
      <Button fx:id="backBtn" layoutX="20.0" layoutY="650.0" mnemonicParsing="false" onAction="#backController" prefHeight="40.0" prefWidth="120.0"
              style="-fx-background-color: #c44018; -fx-font-size: 14px; -fx-border-radius: 8; -fx-background-radius: 8;"
              text="Back" textFill="WHITE">
         <style>
            .button:hover { -fx-background-color: #a83715; }
            .button:pressed { -fx-background-color: #892d12; }
         </style>
      </Button>

      <!-- Search Bar -->
      <TextField fx:id="searchBar" layoutX="400.0" layoutY="80.0" prefHeight="40.0" prefWidth="400.0" promptText="Search movies..."
                 style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-prompt-text-fill: gray; -fx-border-color: #c44018; -fx-border-radius: 8; -fx-background-radius: 8;" />

      <!-- Search Button -->
      <Button layoutX="820.0" layoutY="80.0" mnemonicParsing="false" onAction="#handleSearch" prefHeight="40.0" prefWidth="100.0"
              style="-fx-background-color: #c44018; -fx-font-size: 14px; -fx-border-radius: 8; -fx-background-radius: 8;"
              text="Search" textFill="WHITE">
         <style>
            .button:hover { -fx-background-color: #a83715; }
            .button:pressed { -fx-background-color: #892d12; }
         </style>
      </Button>

      <!-- ScrollPane for Movies -->
      <ScrollPane fx:id="filmsScrollPane" layoutX="260.0" layoutY="130.0" prefHeight="500.0" prefWidth="732.0"
                  style="-fx-background: transparent; -fx-border-color: #c44018; -fx-border-width: 2; -fx-border-radius: 10; -fx-padding: 5;">
         <content>
            <GridPane fx:id="filmsGrid" hgap="30" vgap="20" style="-fx-padding: 10;" />
         </content>
      </ScrollPane>
   </children>
</AnchorPane>
