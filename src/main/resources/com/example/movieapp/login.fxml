<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="502.0" prefWidth="730.0" style="-fx-background-color: #000;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.movieapp.loginController">
   <children>
      <!-- Email Label -->
      <Label layoutX="101.0" layoutY="108.0" prefHeight="27.0" prefWidth="86.0" style="-fx-font-size: 18px; -fx-font-family: 'System';" text="Email" textFill="WHITE" />

      <!-- Password Label -->
      <Label layoutX="101.0" layoutY="186.0" prefHeight="27.0" prefWidth="86.0" style="-fx-font-size: 18px; -fx-font-family: 'System';" text="Password" textFill="WHITE" />

      <!-- Email Text Field -->
      <TextField fx:id="emailTxt" layoutX="226.0" layoutY="109.0" promptText="Enter your email" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #c44018; -fx-padding: 5;" />

      <!-- Password Field -->
      <PasswordField fx:id="passwordTxt" layoutX="226.0" layoutY="187.0" promptText="Enter your password" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #c44018; -fx-padding: 5;" />

      <!-- Login Button -->
      <Button fx:id="loginBtn" layoutX="224.0" layoutY="280.0" onAction="#loginController" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #C44018; -fx-font-size: 16px; -fx-background-radius: 8;" text="Login" textFill="WHITE">
         <style>
            .button:hover { -fx-background-color: #a83715; }
            .button:pressed { -fx-background-color: #892d12; }
         </style>
      </Button>

      <!-- Register Button -->
      <Button fx:id="registerBtn" layoutX="224.0" layoutY="340.0" onAction="#registerController" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #C44018; -fx-font-size: 16px; -fx-background-radius: 8;" text="Register" textFill="WHITE">
         <style>
            .button:hover { -fx-background-color: #a83715; }
            .button:pressed { -fx-background-color: #892d12; }
         </style>
      </Button>

      <!-- Error Label -->
      <Label fx:id="errorLabel" layoutX="226.0" layoutY="245.0" prefHeight="27.0" prefWidth="300.0" style="-fx-font-size: 14px; -fx-font-family: 'System'; -fx-font-weight: bold;" textFill="#C44018" />
   </children>
</AnchorPane>
